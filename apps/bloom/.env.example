# Bloom Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bloom
POSTGRES_USER=bloom
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector Database)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j (Graph Database - optional)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# InfluxDB (Time Series Database - optional)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=bloom
INFLUXDB_PASSWORD=your_secure_influxdb_password_here
INFLUXDB_ORG=bloom
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=your_influxdb_admin_token_here
INFLUXDB_PORT=8086

# ============================================================================
# API Configuration
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=info

# ============================================================================
# Security
# ============================================================================

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# Bloom Configuration
# ============================================================================

BLOOM_ENV=production

# Agent Pool Sizes
BLOOM_NUM_SCRIBES=2
BLOOM_NUM_CONTEXT_MINERS=2
BLOOM_NUM_CHASERS=1

# Feature Flags
BLOOM_ENABLE_AUTONOMOUS_MODE=true
BLOOM_ENABLE_RAG=true
BLOOM_ENABLE_VOICE_SYNTHESIS=false

# ============================================================================
# LLM Configuration
# ============================================================================

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Settings
LLM_PROVIDER=anthropic  # Options: anthropic, openai, gemini
LLM_MODEL=claude-3-5-sonnet-20241022  # or gpt-4-turbo, or gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ============================================================================
# Integration: Slack
# ============================================================================

SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Integration: Email (SMTP)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=bloom@company.com
SMTP_FROM_NAME=Bloom Evaluation System

# ============================================================================
# Integration: Google Calendar
# ============================================================================

# Path to Google Cloud service account JSON
GOOGLE_CALENDAR_CREDENTIALS=/path/to/credentials.json
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# ============================================================================
# Integration: Jira
# ============================================================================

JIRA_URL=https://your-company.atlassian.net
JIRA_USER=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# ============================================================================
# Integration: Git (GitHub/GitLab)
# ============================================================================

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-org
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITLAB_URL=https://gitlab.com

# ============================================================================
# Dashboard Configuration
# ============================================================================

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Bloom
NEXT_PUBLIC_APP_VERSION=1.0.0

# Dashboard Port
DASHBOARD_PORT=3000

# ============================================================================
# Nginx Configuration (if using nginx profile)
# ============================================================================

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# Development Settings
# ============================================================================

# Set to 'development' for local dev
# BLOOM_ENV=development
# LOG_LEVEL=debug
# BLOOM_ENABLE_AUTONOMOUS_MODE=false
